{
  "name": "diary",
  "private": true,
  "version": "2.0.0",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-exe": "vite build && electron-builder",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/run-smoke.mjs",
    "dev-desktop": "electron ."
  },
  "build": {
    "appId": "com.my.diary",
    "productName": "My Diary",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "signExecutable": false
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "electron/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Diary-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Diary-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.4"
  },
  "description": "Local diary with portable workspaces, blocks and databases",
  "author": "SnowGanter"
}
